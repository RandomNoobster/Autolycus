[Unit]
Description=Autolycus update (git pull, rebuild, restart)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/autolycus
ExecStart=/bin/bash /opt/autolycus/scripts/ops/update.sh
# A normal run takes a few minutes; never let a stuck build block the timer.
TimeoutStartSec=45min
