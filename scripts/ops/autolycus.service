[Unit]
Description=Autolycus stack (Docker Compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/autolycus
ExecStart=/usr/bin/docker compose --profile prod up -d --remove-orphans
ExecStop=/usr/bin/docker compose --profile prod down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
