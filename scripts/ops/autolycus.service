[Unit]
Description=Autolycus stack (Docker Compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/autolycus
# Through common.sh so the compose profile follows .env (see compose()).
ExecStart=/bin/bash -c '. /opt/autolycus/scripts/ops/common.sh && compose up -d --remove-orphans'
ExecStop=/bin/bash -c '. /opt/autolycus/scripts/ops/common.sh && compose down'
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
