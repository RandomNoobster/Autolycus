# Copy to .env and replace every YOUR_* / CHANGE_* value.
# cp .env.example .env && chmod 600 .env

# --- Politics & War ---
# Normal API key (game API)
API_KEY=YOUR_PNW_API_KEY
BOT_KEY=YOUR_PNW_BOT_KEY

# --- Discord ---
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Channel ID (digits only) where the bot sends debug/log output
DEBUG_CHANNEL=YOUR_DISCORD_CHANNEL_ID

# --- MongoDB ---
# Often the same URI for both; must match your Atlas/cluster setup
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER_HOST/?appName=autolycus
# Database name (not the cluster name)
MONGO_DB=main

# --- API (Flask / Waitress) ---
# Either production or development
FLASK_ENV=production
# Optional: A random 32 character string. If not set, a random one will be generated.
SECRET_KEY=
# Behind bundled Nginx in Docker: set true
TRUST_PROXY_HEADERS=true
# Shared secret: bot calls API with header X-Bot-Token (keep identical in one .env)
DISCORD_BOT_API_KEY=CHANGE_ME_SHARED_SECRET_BOT_TO_API
# Optional: for POST /api/auth/token/generate from trusted backends
AUTH_TOKEN_API_KEY=

# --- Optional: Waitress settings ---
# WAITRESS_THREADS=8
# WAITRESS_CONNECTION_LIMIT=200
# WAITRESS_CHANNEL_TIMEOUT=30

# --- Optional: Logging settings ---
# LOG_LEVEL=INFO

# --- Frontend (Docker build args; read from same .env by compose) ---
# Empty = browser uses same origin, /api proxied by Nginx
VITE_API_URL=
# If AUTH_TOKEN_API_KEY is set, use the same value here for SPA builds
VITE_AUTH_TOKEN_API_KEY=

# --- Optional: Discord embeds / links (override bogus defaults in bot code) ---
# AUTOLYCUS_WEB_BASE_URL=https://your-server
# AUTOLYCUS_API_BASE_URL=https://your-server/api

# --- Optional: Redis cache (aiocache / logic layer) ---
# Local dev: leave unset to use in-memory cache.
# Docker Compose sets REDIS_URL=redis://redis:6379/0 for api and bot automatically.
# To use Redis on the host instead: REDIS_URL=redis://localhost:6379/0
