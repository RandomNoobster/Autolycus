# Copy to .env and replace every YOUR_* / CHANGE_* value.
# cp .env.example .env && chmod 600 .env

# --- Politics & War ---
# Normal API key (game API)
API_KEY=YOUR_PNW_API_KEY
BOT_KEY=YOUR_PNW_BOT_KEY

# --- Discord ---
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Channel ID (digits only) where the bot sends debug/log output
DEBUG_CHANNEL=YOUR_DISCORD_CHANNEL_ID
# Server invite shown to users whose reminder DMs fail because they share no server with the bot
# AUTOLYCUS_DISCORD_INVITE_URL=https://discord.gg/N79yN5DS4q

# --- MongoDB ---
# Often the same URI for both; must match your Atlas/cluster setup
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER_HOST/?appName=autolycus
# Database name (not the cluster name)
MONGO_DB=main

# --- API (Flask / Waitress) ---
# Either production or development
FLASK_ENV=production
# Optional: A random 32 character string. If not set, a random one will be generated.
SECRET_KEY=
# Discord OAuth session cookie lifetime in days (default 90). Users re-auth when this expires.
# SESSION_LIFETIME_DAYS=90
# Signed bot/link API tokens (separate from OAuth); seconds. Frontend: set VITE_TOKEN_MAX_AGE_SEC to match.
# TOKEN_MAX_AGE_SEC=604800
# Behind bundled Nginx in Docker: set true
TRUST_PROXY_HEADERS=true
# Shared secret: bot calls API with header X-Bot-Token (keep identical in one .env)
DISCORD_BOT_API_KEY=CHANGE_ME_SHARED_SECRET_BOT_TO_API
# Official Discord OAuth web login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override; when empty, API derives:
# ${AUTOLYCUS_WEB_BASE_URL}/api/auth/discord/callback (or request host fallback)
DISCORD_REDIRECT_URI=
# Optional: for POST /api/auth/token/generate from trusted backends
AUTH_TOKEN_API_KEY=

# --- Optional: Browser push notifications for beige reminders ---
# Generate a key with: uv run python scripts/generate_vapid_keys.py
# Leave both empty to keep browser notifications off. Changing the key turns push off on every device.
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: or https:// (not localhost)
VAPID_SUBJECT=
# Reminder delivery tuning (defaults shown)
# REMINDER_DM_RATE_PER_SECOND=25
# REMINDER_STATUS_POLL_SECONDS=100

# --- Optional: Waitress settings ---
# WAITRESS_THREADS=8
# WAITRESS_CONNECTION_LIMIT=200
# WAITRESS_CHANNEL_TIMEOUT=30

# --- Optional: Logging settings ---
# LOG_LEVEL=INFO

# --- Frontend (Docker build args; read from same .env by compose) ---
# Empty = browser uses same origin, /api proxied by Nginx
VITE_API_URL=
# Public origin for Open Graph / Twitter previews (no path, no trailing slash), e.g. https://autolycus.app
# Docker Compose also falls back to AUTOLYCUS_WEB_BASE_URL when this is unset. Leave empty for relative preview URLs in dev.
VITE_SITE_ORIGIN=
# If AUTH_TOKEN_API_KEY is set, use the same value here for SPA builds
VITE_AUTH_TOKEN_API_KEY=
# If you set TOKEN_MAX_AGE_SEC above, set the same value here (seconds) for stored link tokens
# VITE_TOKEN_MAX_AGE_SEC=604800

# --- Optional: Discord bot links and bot -> API HTTP (defaults: Vite + API on localhost) ---
# Local dev: omit both (uses http://localhost:5173 and http://localhost:5000).
# Production: public link origin for users + internal API URL for bot.
# AUTOLYCUS_WEB_BASE_URL=https://your-domain
# AUTOLYCUS_API_BASE_URL=http://api:5000

# Optional: Caddy TLS (used with `docker compose --profile prod ...`)
# SITE_DOMAIN=autolycus.your-domain.com
# ACME_EMAIL=you@your-domain.com

# --- Optional: Redis cache (aiocache / logic layer) ---
# Local dev: leave unset to use in-memory cache.
# Docker Compose sets REDIS_URL=redis://redis:6379/0 for api and bot automatically.
# To use Redis on the host instead: REDIS_URL=redis://localhost:6379/0
